# ------------------------------------------------------------
# BASE DE DONNEES — DEV LOCAL (docker-compose : service `postgres`)
# ------------------------------------------------------------
# Utilisé par Prisma (packages/db) et par l'API en local.
# En docker-compose, `postgres` est le nom du service (résolu sur le réseau interne) ;
# en local hors docker, utiliser `localhost`.
# Rôle `emdb_app` (restreint, sans BYPASSRLS — cf. packages/db/sql/setup_roles.sql,
# auto-créé au premier `docker compose up -d`) : c'est ce rôle qui sert les
# requêtes utilisateur, donc celui soumis aux policies RLS (migration
# enable_rls_user_scoped_tables, cf. wiki/Architecture#securite).
DATABASE_URL=postgresql://emdb_app:emdb_app@localhost:5432/emdb

# Rôle d'origine (BYPASSRLS) : utilisé uniquement par apps/worker (jobs
# transverses à tous les utilisateurs, jamais scopés à un seul).
WORKER_DATABASE_URL=postgresql://emdb:emdb@localhost:5432/emdb

# ------------------------------------------------------------
# SUPABASE (prod cloud — cf. wiki/Déploiement)
# ------------------------------------------------------------
# Connexion directe Postgres (Project Settings > Database > Connection string).
# `postgres` (ou tout rôle avec BYPASSRLS) sert de base pour WORKER_DATABASE_URL ;
# DATABASE_URL (API) doit utiliser le rôle restreint `emdb_app` créé une fois via
# packages/db/sql/setup_roles.sql (SQL editor Supabase) — l'app ne passe pas par
# le SDK/Auth Supabase, uniquement par Postgres (auth JWT maison, cf. apps/api/src/auth).
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ------------------------------------------------------------
# TMDB
# ------------------------------------------------------------
# Clé API v3 (dispo dans : compte TMDB > Settings > API)
TMDB_API_KEY=
# Token v4 (Bearer, optionnel selon les endpoints utilisés)
TMDB_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ------------------------------------------------------------
# REDIS — DEV LOCAL (docker-compose : service `redis`)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# En prod cloud (Upstash) : REDIS_URL=rediss://default:PASSWORD@xxxxx.upstash.io:6379

# ------------------------------------------------------------
# BACKEND (NestJS)
# ------------------------------------------------------------
PORT=3001
NODE_ENV=development
JWT_SECRET=changeme-en-local-uniquement
# Origines autorisées en CORS, séparées par des virgules. En local : laisser
# vide (défaut = localhost:3000/3001). En prod cloud : URL du frontend Vercel.
CORS_ORIGIN=
# true uniquement sur le service Render cloud : lance apps/worker comme
# process enfant dans le même service (cf. wiki/Déploiement). En local,
# docker-compose force EMBED_WORKER=false sur le conteneur api (le worker
# tourne dans son propre conteneur).
EMBED_WORKER=false

# ------------------------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------------------------------
# PUSH (Firebase Cloud Messaging — app Android Capacitor)
# ------------------------------------------------------------
# JSON de la clé de service Firebase (Project Settings > Service Accounts >
# Generate new private key), encodé en base64 (`base64 -w0 service-account.json`
# ou équivalent). Utilisé uniquement par apps/worker (@emdb/push) pour
# l'envoi effectif des notifications — jamais commité.
FIREBASE_SERVICE_ACCOUNT_JSON=
