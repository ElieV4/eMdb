# ------------------------------------------------------------
# BASE DE DONNEES — DEV LOCAL (docker-compose : service `postgres`)
# ------------------------------------------------------------
# Utilisé par Prisma (packages/db) et par l'API/worker en local.
# En docker-compose, `postgres` est le nom du service (résolu sur le réseau interne) ;
# en local hors docker, utiliser `localhost`.
DATABASE_URL=postgresql://emdb:emdb@localhost:5432/emdb

# ------------------------------------------------------------
# SUPABASE (prod cloud — cf. docs/DEPLOIEMENT.md)
# ------------------------------------------------------------
# Connexion directe Postgres (Project Settings > Database > Connection string).
# À utiliser comme DATABASE_URL sur Render — l'app ne passe pas par le SDK/Auth
# Supabase, uniquement par Postgres (auth JWT maison, cf. apps/api/src/auth).
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ------------------------------------------------------------
# TMDB
# ------------------------------------------------------------
# Clé API v3 (dispo dans : compte TMDB > Settings > API)
TMDB_API_KEY=
# Token v4 (Bearer, optionnel selon les endpoints utilisés)
TMDB_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ------------------------------------------------------------
# REDIS — DEV LOCAL (docker-compose : service `redis`)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# En prod cloud (Upstash) : REDIS_URL=rediss://default:PASSWORD@xxxxx.upstash.io:6379

# ------------------------------------------------------------
# BACKEND (NestJS)
# ------------------------------------------------------------
PORT=3001
NODE_ENV=development
JWT_SECRET=changeme-en-local-uniquement
# Origines autorisées en CORS, séparées par des virgules. En local : laisser
# vide (défaut = localhost:3000/3001). En prod cloud : URL du frontend Vercel.
CORS_ORIGIN=
# true uniquement sur le service Render cloud : lance apps/worker comme
# process enfant dans le même service (cf. docs/DEPLOIEMENT.md). En local,
# docker-compose force EMBED_WORKER=false sur le conteneur api (le worker
# tourne dans son propre conteneur).
EMBED_WORKER=false

# ------------------------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
